# ============================================================================
# COUNCIL TICKET SYSTEM - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ============================================================================

# ENVIRONMENT (development or production)
APP_ENV=development

# ============================================================================
# DATABASE
# ============================================================================
# Use PostgreSQL for both local and production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/council_ticket_system

# ============================================================================
# SESSION & SECURITY
# ============================================================================
# Generate a strong SECRET_KEY:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-this-secret-key-in-production

# ============================================================================
# GOOGLE OAUTH
# ============================================================================
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8060/auth/google/callback

# ============================================================================
# FRONTEND URLs (for OAuth redirects)
# ============================================================================
FRONTEND_AUTH_SUCCESS_URL=http://localhost:5173/oauth-success
FRONTEND_AUTH_ERROR_URL=http://localhost:5173/login?oauth=failed

# ============================================================================
# CORS ALLOWED ORIGINS
# ============================================================================
# Comma-separated list of frontend origins allowed to access this API
# Examples:
#   http://localhost:5173,http://localhost:5174  (dev)
#   https://ticket-app.vercel.app  (production)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# ============================================================================
# EMAIL / SMTP (for council notifications)
# ============================================================================
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
COUNCIL_EMAIL=council@example.com

# ============================================================================
# CLOUDINARY (for image uploads)
# ============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# OPTIONAL: Council-specific emails (for auto-assignment)
# ============================================================================
COUNCIL_HEALTH_EMAIL=health.council@example.com
COUNCIL_DISCIPLINE_EMAIL=discipline.council@example.com
COUNCIL_CLEANLINESS_EMAIL=cleanliness.council@example.com
COUNCIL_ENGLISH_EMAIL=english.council@example.com
COUNCIL_LIFESKILL_EMAIL=lifeskill.council@example.com
COUNCIL_PLACEMENT_EMAIL=placement.council@example.com
COUNCIL_IT_EMAIL=it.council@example.com
COUNCIL_FACILITY_EMAIL=facility.council@example.com
COUNCIL_EVENT_EMAIL=event.council@example.com
COUNCIL_SAFETY_EMAIL=safety.council@example.com
COUNCIL_ONBOARDING_EMAIL=onboarding.council@example.com
COUNCIL_KITCHEN_EMAIL=kitchen.council@example.com
COUNCIL_ACADEMIC_EMAIL=academic.council@example.com
COUNCIL_OFFBOARDING_EMAIL=offboarding.council@example.com

